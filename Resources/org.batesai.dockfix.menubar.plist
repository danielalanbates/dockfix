<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  "Open DockFix at login". Registered by the app with SMAppService (Contents/Library/LaunchAgents).
  The job runs DockFix with the launch-menubar flag, which starts the menu bar app through
  LaunchServices (with the menubar flag, so no window opens) and exits. The app is never the job's
  own process, so unregistering the job (Open at Login off) can't kill it. Does nothing if DockFix
  is already running. Not kept alive: quitting DockFix keeps it quit until the next login.
-->
<dict>
	<key>Label</key>
	<string>org.batesai.dockfix.menubar</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/DockFix</string>
	<key>ProgramArguments</key>
	<array>
		<string>DockFix</string>
		<string>--launch-menubar</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>org.batesai.dockfix</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
